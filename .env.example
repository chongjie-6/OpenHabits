# hapi — environment
#
# All of this is optional. With none of it set the app runs exactly as it did
# before sync existed: IndexedDB is the source of truth, /api/sync answers 503,
# /api/auth answers 503, and the client treats sync as switched off. Nothing
# degrades and no screen changes except the Account card, which explains itself.

# Postgres connection string. Any Postgres will do; Neon is the assumed host.
# Include ?sslmode=require for a hosted database.
#
# This one variable turns on both sync and accounts — they share a database and
# neither is useful without it.
DATABASE_URL=

# Signs session cookies. Required in production, where Better Auth refuses to
# start without it; in development it falls back to a fixed dev secret.
# Changing it signs every existing session out.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Only needed when the app cannot work out its own public URL — behind a proxy
# that rewrites Host, most typically. Left blank it is inferred per request,
# which is right for local development and for a normal single-domain deploy.
BETTER_AUTH_URL=

# Local development only — a fixed identity that bypasses sign-in entirely, so
# sync can be worked on without touching auth. Ignored when NODE_ENV=production,
# deliberately: the failure worth preventing is this line surviving into a real
# deployment, where it would make every visitor the same account.
#
# Note this is now a bypass rather than a stand-in. Set it and every request is
# this account no matter who is actually signed in, which also means the
# signed-out path cannot be exercised. Leave it unset unless that is the point.
HAPI_DEV_USER_ID=
HAPI_DEV_USER_EMAIL=

# NEXT_PUBLIC_SYNC_ENABLED is gone. It was a build-time placeholder for "should
# this client sync", and the answer is now "is someone signed in" — read per
# device from the browser rather than baked into the bundle. See
# lib/sync/client.ts:syncEnabled and lib/session.ts.
