# OpenHabits — environment
#
# All of this is optional. With none of it set the app runs exactly as it did
# before sync existed: IndexedDB is the source of truth, /api/sync answers 503,
# /api/auth answers 503, and the client treats sync as switched off. Nothing
# degrades and no screen changes except the Account card, which explains itself.

# Postgres connection string. Any Postgres will do; Neon is the assumed host.
# Include ?sslmode=require for a hosted database.
#
# This one variable turns on both sync and accounts — they share a database and
# neither is useful without it.
DATABASE_URL=

# Signs session cookies. Required in production, where Better Auth refuses to
# start without it; in development it falls back to a fixed dev secret.
# Changing it signs every existing session out.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The app's own public origin, e.g. https://openhabits.example. Required in
# production once DATABASE_URL is set: accounts refuse to start without it.
#
# Inferring it would mean reading it off the request's Host header, and
# /api/auth/send-verification-email takes any address with no session — so a
# forged Host makes this app mail a real verification link into someone else's
# server, and the token in it is a session. Development still infers, where the
# only Host on offer is your own.
BETTER_AUTH_URL=

# For a deployment answering on more than one host — preview URLs beside a
# custom domain. Comma-separated, wildcards allowed; the origin is then resolved
# per request against this list and every host outside it is refused. Overrides
# BETTER_AUTH_URL, which becomes the fallback when a request names no host.
#
#   BETTER_AUTH_ALLOWED_HOSTS=openhabits.example,*.vercel.app
BETTER_AUTH_ALLOWED_HOSTS=

# Gmail SMTP credentials for sending mail (an app password, not the account
# password). Optional, same effect on §13.10 verification-gating as before.
SMTP_USER=
SMTP_PASSWORD=

# A fixed identity for local development against a real database without
# signing in: every request becomes this account, whoever is signed in. A
# bypass, not a stand-in — it is ignored when NODE_ENV=production, because the
# failure worth preventing is this variable surviving into a real deployment.
# The email is optional and defaults to <id>@openhabits.local.
OPENHABITS_DEV_USER_ID=
OPENHABITS_DEV_USER_EMAIL=
