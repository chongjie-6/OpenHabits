# OpenHabits — environment
#
# All of this is optional. With none of it set the app runs exactly as it did
# before sync existed: IndexedDB is the source of truth, /api/sync answers 503,
# /api/auth answers 503, and the client treats sync as switched off. Nothing
# degrades and no screen changes except the Account card, which explains itself.

# Postgres connection string. Any Postgres will do; Neon is the assumed host.
# Include ?sslmode=require for a hosted database.
#
# This one variable turns on both sync and accounts — they share a database and
# neither is useful without it.
#
# Use an ordinary role, not a superuser. Every table is under row-level security
# (DESIGN.md §13.15) and a role with BYPASSRLS ignores all of it — silently, with
# no error and no wrong-looking query. Neon's default role is fine; `postgres` on
# a local install is not. `npm run db:migrate` warns if the role applying the
# migrations is a superuser.
#
# CI applies the migrations before it deploys, so this value has to reach the
# repository as well as the host — as a DATABASE_URL secret on the production
# environment (.github/workflows/ci.yml). Missing there, the schema quietly stops
# tracking the code, and the first query against a table the migrations were
# going to create 500s.
DATABASE_URL=

# The app's own public origin, e.g. https://openhabits.example. Purely
# cosmetic, and separate from BETTER_AUTH_URL below on purpose: this one decides
# what a link preview's image URL says, so a deployment with no accounts at all
# still wants it, and getting it wrong costs a broken OG card rather than a
# security property.
#
# Unset, it falls back to BETTER_AUTH_URL, then to Vercel's production domain,
# then to http://localhost:3000 — which is what Next would have inferred anyway.
SITE_URL=

# Signs session cookies. Required in production, where Better Auth refuses to
# start without it; in development it falls back to a fixed dev secret.
# Changing it signs every existing session out.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The app's own public origin, e.g. https://openhabits.example. Required in
# production once DATABASE_URL is set: accounts refuse to start without it.
#
# Inferring it would mean reading it off the request's Host header, and
# /api/auth/send-verification-email takes any address with no session — so a
# forged Host makes this app mail a real verification link into someone else's
# server, and the token in it is a session. Development still infers, where the
# only Host on offer is your own.
BETTER_AUTH_URL=

# For a deployment answering on more than one host — preview URLs beside a
# custom domain. Comma-separated, wildcards allowed; the origin is then resolved
# per request against this list and every host outside it is refused. Overrides
# BETTER_AUTH_URL, which becomes the fallback when a request names no host.
#
#   BETTER_AUTH_ALLOWED_HOSTS=openhabits.example,*.vercel.app
BETTER_AUTH_ALLOWED_HOSTS=

# Gmail SMTP credentials for sending mail (an app password, not the account
# password). Optional, same effect on §13.10 verification-gating as before.
#
# Password reset follows them too: with no mailer there is no link to send, so
# /api/auth/request-password-reset answers RESET_PASSWORD_DISABLED and the
# account card says this deployment cannot reset a password rather than
# offering a button into nothing.
SMTP_USER=
SMTP_PASSWORD=

# The From header on outbound mail. Unset, it is "OpenHabits <SMTP_USER>".
#
# Gmail rewrites From to the authenticated account unless the address is a
# verified "Send mail as" alias on it, so changing the address here without
# doing that in Gmail first changes nothing a recipient sees. The display name
# does come through either way.
#
#   MAIL_FROM=OpenHabits <noreply@openhabits.example>
MAIL_FROM=

# A fixed identity for local development against a real database without
# signing in: every request becomes this account, whoever is signed in. A
# bypass, not a stand-in — it is ignored when NODE_ENV=production, because the
# failure worth preventing is this variable surviving into a real deployment.
# The email is optional and defaults to <id>@openhabits.local.
OPENHABITS_DEV_USER_ID=
OPENHABITS_DEV_USER_EMAIL=

# --- Daily reminders (DESIGN.md §8.5) ---------------------------------------
#
# Also optional, and independent of everything above except DATABASE_URL, which
# reminders need in order to know whose habits to count. With no keypair set the
# /api/reminders endpoint says so, and the Settings card explains that this
# deployment cannot send rather than offering a switch that would do nothing.

# The VAPID keypair the push services use to verify this sender. Generate one:
#
#   npx web-push generate-vapid-keys
#
# The public half is served to the browser on subscribe — it is public by
# construction. The private half signs; changing it invalidates every existing
# subscription, and every device has to turn reminders on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A mailto: or https: address a push service can use to reach whoever runs this
# deployment about a misbehaving sender. Required by the VAPID spec, so reminders
# stay switched off without it. Falls back to BETTER_AUTH_URL when that is a
# plain https origin.
#
#   VAPID_SUBJECT=mailto:you@example.com
VAPID_SUBJECT=

# Authenticates the hourly sweep at /api/cron/reminders. The scheduler sends it
# as `Authorization: Bearer <value>`, so the same value has to reach both this
# deployment and whatever calls it. Unset is not
# "open to everyone" — the route reads every account's habits, so it refuses to
# run at all rather than run for whoever asks.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The schedule lives in worker/ and runs hourly, because nine in the morning
# happens twenty-something times a day across the timezones and one daily
# invocation can only ever be nine o'clock in one of them. It is a Cloudflare
# Worker cron trigger rather than an entry in vercel.json because Vercel caps
# cron at daily below Pro, and a daily cron reaches one timezone's users at the
# right hour and nobody else's. The Worker needs this same value as a secret of
# the same name, beside a SITE_URL var in worker/wrangler.jsonc — see
# docs/DEPLOYMENT.md.
CRON_SECRET=

# --- Rate limiting and the mail queue (DESIGN.md §13.16, §13.17) -------------
#
# Optional like everything above, and independent of it. With none of these set
# nothing is metered and mail is sent inline inside the request, which is exactly
# what this app did before either feature existed.
#
# Create both in the Upstash console (console.upstash.com): a Redis database in
# the region nearest DATABASE_URL, and a QStash instance. The free tiers are
# ample — the limiters spend one command per request and the queue one message
# per email.

# Upstash Redis, over its REST API. Turns on rate limiting, and is also where the
# mail queue parks an email while QStash carries its id — so the queue needs this
# as well as a token of its own.
#
# Both halves or neither: with one set the other is treated as unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash, which decouples outbound mail from the request that caused it. Without
# it, verification and reset mail is awaited inline — so sign-up waits on Gmail,
# and a send that fails is a sign-up the user has to repeat.
#
# With it, what the sign-up waits for is the hand-off: a failure to *enqueue*
# still fails the sign-up and frees the address, and a failure to *send* is
# retried three times and then parked in the dead letter queue. That last part is
# new and worth knowing about — an account can now exist while its verification
# mail is stuck in the DLQ, and nothing alerts about it. Check the DLQ in the
# QStash console if someone reports never receiving the link.
#
# Ignored on localhost, whatever it is set to: QStash delivers by making an HTTP
# request from its own network and cannot reach a laptop, so a development
# machine sends inline rather than filling the DLQ with messages that cannot be
# delivered. A public origin is needed to exercise this path — a preview
# deployment, or a tunnel with SITE_URL pointed at it.
QSTASH_TOKEN=

# The keys /api/email verifies incoming deliveries with. Both are shown in the
# QStash console beside the token; the "next" key exists so a rotation does not
# drop the messages already in flight.
#
# Unset is not "accept anything" — the route mails a link to an address its own
# body names, so with no way to tell who is asking it refuses every request. Set
# QSTASH_TOKEN without these and mail is enqueued and never delivered.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
